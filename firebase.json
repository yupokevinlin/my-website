{
  "hosting": {
    "public": "dist/apps/my-website",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "regex": "^/resources/resume/Kevin(%20| )Lin('|%27)s(%20| )Resume\\.pdf$",
        "destination": "/resources/resume/kevin-lin-resume.pdf",
        "type": 301
      },
      {
        "source": "/v2",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/ray-tracing/sky/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ]
  }
}
