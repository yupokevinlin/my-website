# Firebase Web SDK config (used for Analytics).
# These NEXT_PUBLIC_* values are embedded in the client bundle at build time.
# The Firebase web API key is NOT a secret — it identifies the project and is
# safe to expose; access is controlled by Security Rules and authorized domains.
# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
